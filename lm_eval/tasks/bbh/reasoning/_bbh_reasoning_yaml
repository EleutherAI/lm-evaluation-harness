dataset_path: SaylorTwift/bbh
output_type: generate_until
test_split: test
doc_to_text: "Q: {{input}}\nA: Let's think step by step."
doc_to_target: "{{target}}"
target_delimiter: ""
description: "A evaluation variant for reasoning-style models (DeepSeek-R1 and similar) that emit a <think>...</think> trace before their answer. Use with --apply_chat_template. "
filter_list:
  - name: "get-answer"
    filter:
      # strip the reasoning trace before extraction (issue #2682)
      - function: "strip_think"
      - function: "regex"
        regex_pattern: "(?<=the answer is )(.*)(?=.)"
      - function: "take_first"
# R1-style traces are long: give the model room to think, and do not
# stop on delimiters that occur inside the trace
generation_kwargs:
  max_gen_toks: 32768
  until:
    - "</s>"
    - "<|im_end|>"
  do_sample: false
  temperature: 0.0
num_fewshot: 3
metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true
metadata:
  version: 4.0
