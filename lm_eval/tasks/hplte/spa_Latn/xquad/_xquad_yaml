dataset_path: google/xquad
dataset_name: xquad.es
dataset_kwargs:
  revision: 51adfef1c1287aab1d2d91b5bead9bcfb9c68583
output_type: generate_until
validation_split: validation
doc_to_target: '{{answers["text"][0]}}'
process_results: !function utils.process_results_xquad
generation_kwargs:
  until:
    - "\n"
    - "</s>"
    - "<eos>"
  do_sample: false
  num_beams: 1
  max_new_tokens: 64
metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true
  - metric: f1
    aggregation: mean
    higher_is_better: true
metadata:
  version: 1.0
