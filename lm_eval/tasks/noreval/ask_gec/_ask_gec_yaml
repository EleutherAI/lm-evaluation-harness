dataset_path: ltg/ask-gec
dataset_kwargs:
  revision: 9871205efddb575e77c4b49443ff75e28e25deae
output_type: generate_until
training_split: train
validation_split: validation
test_split: test
doc_to_target: correction
process_results: !function utils.process_results
generation_kwargs:
  until:
    - "\n"
  do_sample: true
  temperature: 1.0
  top_p: 1.0
  top_k: 0
  max_new_tokens: 256
metric_list:
  - metric: errant_f05
    aggregation: !function utils.errant_agg
    higher_is_better: true
  - metric: errant_f05_stderr
    aggregation: !function utils.errant_f05_stderr
    higher_is_better: false
repeats: &samples 3
filter_list:
  - name: sampling
    filter:
      - function: take_first_k
        k: *samples
metadata:
  version: 1.3
