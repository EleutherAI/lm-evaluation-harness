dataset_path: djolex999/serbeval
test_split: test
output_type: generate_until
doc_to_text: !function utils.doc_to_text_correction
doc_to_target: !function utils.doc_to_target_correction
process_results: !function utils.process_results_correction
generation_kwargs:
  # No "\n\n" stop: a model that explains first must not be cut off before its answer line.
  until:
    - "\n\n\n"
  max_gen_toks: 160
  do_sample: false
  temperature: 0.0
metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true
  - metric: unparsed
    aggregation: mean
    higher_is_better: false
metadata:
  version: 1.0
